# =================================================================
# STUDIX BACKEND ENVIRONMENT VARIABLES (SERVER)
# =================================================================
# For local development: copy this to .env (do NOT commit .env!)
# For production (Render / Railway): set these in the dashboard
# =================================================================

# Server port and runtime environment
PORT=4000
NODE_ENV=development

# Allowed frontend client URLs (comma-separated for multiple origins)
# For Render, add your Vercel deployment URL here:
CLIENT_ORIGIN=http://localhost:5173,https://your-studix-client.vercel.app

# MongoDB Connection String (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studix?retryWrites=true&w=majority

# Redis (Upstash Redis, Redis Cloud, or local Redis)
REDIS_ENABLED=true
REDIS_URL=rediss://default:<password>@<host>:<port>

# Firebase Admin SDK Configuration
# Option 1 (Cloud / Render recommended): Base64 encoded serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option 2 (Local file): Relative path to serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option 3: Explicit project ID (used when Google Default Credentials are active)
FIREBASE_PROJECT_ID=

# Chat Rate Limiting
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=5
