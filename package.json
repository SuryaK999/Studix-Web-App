{
  "name": "studix-web-app",
  "version": "1.0.0",
  "description": "Studix Web App - Collaborative Study Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node start-dev.mjs",
    "dev": "node start-dev.mjs",
    "dev:all": "node start-dev.mjs",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "start:server": "npm start --prefix server",
    "verify": "npm run verify --prefix server",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "keywords": [
    "studix",
    "study-rooms",
    "react",
    "vite",
    "express",
    "socketio"
  ],
  "author": "Surya K",
  "license": "ISC"
}
